# Separate database on the same PostgreSQL server as PMV
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/manhour_system?schema=public"

# Long random string used to sign login sessions (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
AUTH_SECRET=""

# Set to "true" only if the app is served over plain http (no HTTPS) in production, otherwise login cookies are rejected
INSECURE_COOKIES="false"

# Where photographed sheets are stored (relative to the project folder or absolute, e.g. D:\manhour-uploads)
UPLOAD_DIR="./uploads"

# Optional: folder holding Tesseract language data (eng.traineddata) for fully offline photo reading.
# Leave empty to download it automatically on first use (needs internet once).
TESSDATA_DIR=""

# First admin account, used once by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"
