# Separate database on the same PostgreSQL server as PMV
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/manhour_system?schema=public"

# Long random string used to sign login sessions and to encrypt the AI providers' API keys
# (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))")
# If you change it later, re-enter the API keys in Settings › Photo reading.
AUTH_SECRET=""

# Set to "true" only if the app is served over plain http (no HTTPS) in production, otherwise login cookies are rejected
INSECURE_COOKIES="false"

# Where photographed sheets are stored (relative to the project folder or absolute, e.g. D:\manhour-uploads)
UPLOAD_DIR="./uploads"

# Optional: folder holding Tesseract language data (eng.traineddata) for fully offline photo reading.
# Leave empty to download it automatically on first use (needs internet once).
TESSDATA_DIR=""

# First admin account, used once by `npm run db:seed`
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_NAME="Administrator"

# ---- Email (shift alerts to supervisors) ----
# Microsoft 365 through Microsoft Graph (recommended for Outlook / Exchange Online):
# an Entra ID app registration with the Mail.Send *application* permission (admin consent granted).
MAIL_PROVIDER="graph"
# Sender mailbox, e.g. noreply@yourcompany.com
MAIL_FROM=""
GRAPH_TENANT_ID=""
GRAPH_CLIENT_ID=""
GRAPH_CLIENT_SECRET=""
# Or any SMTP server instead (MAIL_PROVIDER="smtp"):
# (the PMV system's names SMTP_PASS and SMTP_FROM work too; without a sender, SMTP_USER is used)
# SMTP_HOST=""
# SMTP_PORT="587"
# SMTP_SECURE="false"
# SMTP_USER=""
# SMTP_PASSWORD=""
# MAIL_PROVIDER="log" writes emails to the server log instead of sending them (testing).

# Push notifications (optional). Leave empty: keys are generated once and kept in the database.
# Set them to keep the same keys when moving the database (generate with: npx web-push generate-vapid-keys).
# VAPID_PUBLIC_KEY=""
# VAPID_PRIVATE_KEY=""
# VAPID_SUBJECT="mailto:it@yourcompany.com"
