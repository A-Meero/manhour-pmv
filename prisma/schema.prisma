generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum DataSource {
  MANUAL
  EXCEL
  API
  PHOTO
  /// Start/stop scans of the job card QR code
  QR
}

enum RepairType {
  WORKSHOP
  ONSITE
}

enum PartRequestLineStatus {
  OPEN
  /// Being bought outside the system (material request)
  MR_RAISED
  DONE
}

enum PartRequestStatus {
  OPEN
  /// The items are being bought outside the system (material request)
  MR_RAISED
  FULFILLED
}

enum JobCardStatus {
  OPEN
  CLOSED
}

enum StockMovementKind {
  RECEIVE
  ADJUST
  ISSUE
  ISSUE_REVERSAL
}

enum FieldEntity {
  JOB_CARD
  EMPLOYEE
  RECORD
}

enum FieldType {
  TEXT
  NUMBER
  DATE
  SELECT
  CHECKBOX
}

enum ImportKind {
  JOB_CARDS
  EMPLOYEES
  RECORDS
  PARTS
  ASSETS
}

enum ScanStatus {
  PENDING_REVIEW
  SAVED
  DISCARDED
}

model User {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  passwordHash   String
  /// Admins can do everything; everyone else gets what their permission groups allow
  isAdmin        Boolean   @default(false)
  active         Boolean   @default(true)
  /// Employee record this login belongs to (technicians, own-records entry)
  employeeId     String?   @unique
  employee       Employee? @relation("UserEmployee", fields: [employeeId], references: [id], onDelete: SetNull)
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  supervising           EmployeeSupervisor[]
  recordsCreated        ManHourRecord[]      @relation("RecordCreatedBy")
  recordsUpdated        ManHourRecord[]      @relation("RecordUpdatedBy")
  scans                 ScanSheet[]
  importBatches         ImportBatch[]
  auditLogs             AuditLog[]
  apiKeysCreated        ApiKey[]
  jobCardsClosed        JobCard[]            @relation("JobCardClosedBy")
  workSessions          WorkSession[]        @relation("SessionUser")
  sessionsEdited        WorkSession[]        @relation("SessionEditedBy")
  stockMovements        StockMovement[]
  groups                UserGroup[]
  notifications         Notification[]
  jobCardsAdded         JobCard[]            @relation("JobCardAddedBy")
  partRequests          PartRequest[]        @relation("PartRequestBy")
  partRequestsFulfilled PartRequest[]        @relation("PartRequestFulfilledBy")
  partRequestLinesDone  PartRequestLine[]    @relation("PartRequestLineDoneBy")
  assignmentsMade       JobCardAssignment[]  @relation("JobCardAssignedBy")
  pushSubscriptions     PushSubscription[]
  /// Notification kinds this user doesn't want as push notifications (still shown in the app)
  mutedPushKinds        String[]             @default([])
}

/// A named set of permissions (see src/lib/permissions.ts). Users get the union of their groups' permissions.
model PermissionGroup {
  id          String   @id @default(cuid())
  name        String   @unique
  description String   @default("")
  permissions String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members UserGroup[]
}

model UserGroup {
  userId    String
  groupId   String
  createdAt DateTime @default(now())

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  group PermissionGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([userId, groupId])
  @@index([groupId])
}

/// In-app notification. dedupeKey stops the same event being sent twice to the same user.
model Notification {
  id        String    @id @default(cuid())
  userId    String
  kind      String
  title     String
  body      String    @default("")
  link      String    @default("")
  dedupeKey String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, dedupeKey])
  @@index([userId, readAt, createdAt])
}

/// Equipment / vehicle the job cards are for. "Code" on the printed job card.
model Asset {
  id               String    @id @default(cuid())
  code             String    @unique
  description      String    @default("")
  category         String    @default("")
  location         String    @default("")
  make             String    @default("")
  model            String    @default("")
  serialNo         String    @default("")
  chassisNo        String    @default("")
  plateNo          String    @default("")
  yearOfMake       Int?
  purchaseDate     DateTime? @db.Date
  /// KWD
  purchaseValue    Decimal?  @db.Decimal(12, 3)
  /// Straight-line depreciation, % of the purchase value per year
  depreciationRate Decimal?  @db.Decimal(5, 2)
  notes            String    @default("")
  active           Boolean   @default(true)
  customFields     Json      @default("{}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  jobCards JobCard[]

  @@index([plateNo])
  @@index([chassisNo])
  @@index([category])
}

/// A "Work Done" line printed on the job card.
model JobCardTask {
  id          String    @id @default(cuid())
  jobCardId   String
  line        Int
  description String
  fromDate    DateTime? @db.Date

  jobCard JobCard @relation(fields: [jobCardId], references: [id], onDelete: Cascade)

  @@index([jobCardId])
}

model Employee {
  id           String     @id @default(cuid())
  fileNo       String     @unique
  name         String
  jobTitle     String     @default("")
  /// Labour cost per hour (KWD)
  hourlyRate   Decimal    @default(0) @db.Decimal(10, 3)
  /// Working shift; used to stop QR sessions left running after the shift and alert the supervisor
  shiftId      String?
  active       Boolean    @default(true)
  customFields Json       @default("{}")
  source       DataSource @default(MANUAL)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  user             User?                @relation("UserEmployee")
  shift            Shift?               @relation(fields: [shiftId], references: [id], onDelete: SetNull)
  supervisors      EmployeeSupervisor[]
  records          ManHourRecord[]
  workSessions     WorkSession[]
  jobCardsReceived JobCard[]            @relation("JobCardReceivedBy")
  assignments      JobCardAssignment[]

  @@index([name])
  @@index([shiftId])
}

/// A working shift, e.g. Morning 07:00–15:00 Sat–Thu. endTime ≤ startTime means it ends the next day.
model Shift {
  id        String   @id @default(cuid())
  name      String   @unique
  /// "HH:MM" in the app's time zone (Asia/Kuwait)
  startTime String
  endTime   String
  /// Weekdays the shift starts on: 0 = Sunday … 6 = Saturday
  days      Int[]    @default([])
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees Employee[]
}

model EmployeeSupervisor {
  employeeId   String
  supervisorId String
  createdAt    DateTime @default(now())

  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  supervisor User     @relation(fields: [supervisorId], references: [id], onDelete: Cascade)

  @@id([employeeId, supervisorId])
  @@index([supervisorId])
}

model JobCard {
  id               String        @id @default(cuid())
  code             String        @unique
  active           Boolean       @default(true)
  /// Closed cards take no more QR sessions, part issues or (non-admin) records
  status           JobCardStatus @default(OPEN)
  closedAt         DateTime?
  closedById       String?
  customFields     Json          @default("{}")
  source           DataSource    @default(MANUAL)
  /// Printed header of the original job card (code above = "Rep.Order Number")
  assetId          String?
  dateIn           DateTime?     @db.Date
  dateOut          DateTime?     @db.Date
  previousReading  Decimal?      @db.Decimal(12, 1)
  currentReading   Decimal?      @db.Decimal(12, 1)
  jobType          String        @default("")
  repairAt         String        @default("")
  project          String        @default("")
  operatorName     String        @default("")
  receivedBy       String        @default("")
  /// The employee the printed "Received by" was matched to
  receivedById     String?
  /// Added without the original document (typed, Excel, API): it must be uploaded (created in Oracle first)
  documentRequired Boolean       @default(false)
  /// Workshop or onsite repair (null on older cards with no "Repair at")
  repairType       RepairType?
  createdByName    String        @default("")
  /// Photo of the original card, relative to the uploads folder
  photoPath        String        @default("")
  addedById        String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  asset              Asset?              @relation(fields: [assetId], references: [id], onDelete: Restrict)
  addedBy            User?               @relation("JobCardAddedBy", fields: [addedById], references: [id], onDelete: SetNull)
  closedBy           User?               @relation("JobCardClosedBy", fields: [closedById], references: [id], onDelete: SetNull)
  receivedByEmployee Employee?           @relation("JobCardReceivedBy", fields: [receivedById], references: [id], onDelete: SetNull)
  partRequests       PartRequest[]
  assignments        JobCardAssignment[]
  tasks              JobCardTask[]
  records            ManHourRecord[]
  workSessions       WorkSession[]
  stockMovements     StockMovement[]

  @@index([status])
  @@index([assetId, status])
  @@index([receivedById])
}

/// A job card assigned by its received-by team leader to one of his team members (a to-do; scanning is not limited).
model JobCardAssignment {
  id           String   @id @default(cuid())
  jobCardId    String
  employeeId   String
  assignedById String?
  createdAt    DateTime @default(now())

  jobCard    JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  assignedBy User?    @relation("JobCardAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@unique([jobCardId, employeeId])
  @@index([employeeId])
}

/// A request for spare parts on a job card (lines below), open until all its lines are done.
model PartRequest {
  id            String            @id @default(cuid())
  jobCardId     String
  requestedById String?
  /// Optional note (the items are the lines)
  text          String            @default("")
  status        PartRequestStatus @default(OPEN)
  mrNumber      String            @default("")
  storeNote     String            @default("")
  mrRaisedAt    DateTime?
  fulfilledById String?
  fulfilledAt   DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  jobCard     JobCard           @relation(fields: [jobCardId], references: [id], onDelete: Cascade)
  requestedBy User?             @relation("PartRequestBy", fields: [requestedById], references: [id], onDelete: SetNull)
  fulfilledBy User?             @relation("PartRequestFulfilledBy", fields: [fulfilledById], references: [id], onDelete: SetNull)
  lines       PartRequestLine[]

  @@index([status])
  @@index([jobCardId])
}

/// One item asked for in a part request: free text + quantity. The store ticks it done or records an MR for it.
model PartRequestLine {
  id          String                @id @default(cuid())
  requestId   String
  line        Int
  description String
  qty         Decimal?              @db.Decimal(12, 3)
  status      PartRequestLineStatus @default(OPEN)
  mrNumber    String                @default("")
  mrRaisedAt  DateTime?
  doneById    String?
  doneAt      DateTime?
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  request PartRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  doneBy  User?       @relation("PartRequestLineDoneBy", fields: [doneById], references: [id], onDelete: SetNull)

  @@index([requestId])
}

/// A browser / phone that receives push notifications for a user.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String    @default("")
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model ManHourRecord {
  id             String     @id @default(cuid())
  employeeId     String
  jobCardId      String
  startDate      DateTime   @db.Date
  endDate        DateTime   @db.Date
  hours          Decimal    @db.Decimal(10, 2)
  remarks        String     @default("")
  customFields   Json       @default("{}")
  /// Snapshots taken from the employee at entry time (template header fields)
  employeeName   String     @default("")
  jobTitle       String     @default("")
  supervisorName String     @default("")
  /// Employee's hourly rate when the record was saved (null on records from before rates existed)
  hourlyRate     Decimal?   @db.Decimal(10, 3)
  /// "Prepared By" / "Approved By" from the sheet (names only)
  preparedByName String     @default("")
  preparedByDate DateTime?  @db.Date
  approvedByName String     @default("")
  approvedByDate DateTime?  @db.Date
  source         DataSource @default(MANUAL)
  scanId         String?
  importBatchId  String?
  createdById    String?
  updatedById    String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  employee    Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  jobCard     JobCard      @relation(fields: [jobCardId], references: [id], onDelete: Restrict)
  scan        ScanSheet?   @relation(fields: [scanId], references: [id], onDelete: SetNull)
  importBatch ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  createdBy   User?        @relation("RecordCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy   User?        @relation("RecordUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)

  /// A job card can be recorded only once per employee (closed after submission)
  @@unique([employeeId, jobCardId])
  @@index([startDate])
  @@index([endDate])
  @@index([jobCardId])
}

/// One start→stop period of a technician working on a job card (QR scans). Summed into one ManHourRecord.
model WorkSession {
  id               String    @id @default(cuid())
  employeeId       String
  jobCardId        String
  /// Login that scanned
  userId           String?
  startedAt        DateTime
  /// null while the technician is still working
  endedAt          DateTime?
  /// Stopped by the system after the maximum session length
  autoStopped      Boolean   @default(false)
  /// Still running after the shift ended: when the technician was reminded (timer keeps going)
  shiftReminderAt  DateTime?
  /// Shift end of that reminder (for "I finished at shift end")
  shiftEndAt       DateTime?
  /// Stopped by the system when the daily / weekly limit (or max session length) was reached after the shift
  limitStoppedAt   DateTime?
  /// Technician's answer to the after-shift question: CONTINUE | SHIFT_END | KEEP
  afterShiftAnswer String?
  needsReview      Boolean   @default(false)
  reviewNote       String    @default("")
  editedById       String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  jobCard  JobCard  @relation(fields: [jobCardId], references: [id], onDelete: Restrict)
  user     User?    @relation("SessionUser", fields: [userId], references: [id], onDelete: SetNull)
  editedBy User?    @relation("SessionEditedBy", fields: [editedById], references: [id], onDelete: SetNull)

  @@index([jobCardId])
  @@index([employeeId, endedAt])
  @@index([needsReview])
}

model Part {
  id        String   @id @default(cuid())
  partNo    String   @unique
  name      String
  unit      String   @default("pcs")
  unitCost  Decimal  @default(0) @db.Decimal(10, 3)
  qtyOnHand Decimal  @default(0) @db.Decimal(12, 3)
  /// Highlight as low stock at or below this quantity
  minQty    Decimal? @db.Decimal(12, 3)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  movements StockMovement[]

  @@index([name])
}

/// Every change to a part's stock. ISSUE / ISSUE_REVERSAL rows are the parts used on a job card.
model StockMovement {
  id         String            @id @default(cuid())
  partId     String
  kind       StockMovementKind
  /// Signed: + adds to stock, − takes from it
  qty        Decimal           @db.Decimal(12, 3)
  unitCost   Decimal           @db.Decimal(10, 3)
  jobCardId  String?
  /// For ISSUE_REVERSAL: the ISSUE it reverses
  reversesId String?           @unique
  note       String            @default("")
  userId     String?
  createdAt  DateTime          @default(now())

  part     Part           @relation(fields: [partId], references: [id], onDelete: Restrict)
  jobCard  JobCard?       @relation(fields: [jobCardId], references: [id], onDelete: Restrict)
  user     User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  reverses StockMovement? @relation("Reversal", fields: [reversesId], references: [id], onDelete: Restrict)
  reversal StockMovement? @relation("Reversal")

  @@index([partId, createdAt])
  @@index([jobCardId])
}

model FieldDefinition {
  id        String      @id @default(cuid())
  entity    FieldEntity
  key       String
  label     String
  type      FieldType   @default(TEXT)
  required  Boolean     @default(false)
  options   String[]    @default([])
  sortOrder Int         @default(0)
  active    Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@unique([entity, key])
}

model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model ScanSheet {
  id           String     @id @default(cuid())
  filePath     String
  mimeType     String
  ocrEngine    String     @default("")
  ocrError     String     @default("")
  rawText      String     @default("")
  extracted    Json       @default("{}")
  status       ScanStatus @default(PENDING_REVIEW)
  uploadedById String?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  uploadedBy User?           @relation(fields: [uploadedById], references: [id], onDelete: SetNull)
  records    ManHourRecord[]
}

model ImportBatch {
  id          String     @id @default(cuid())
  kind        ImportKind
  source      DataSource
  fileName    String     @default("")
  totalRows   Int        @default(0)
  created     Int        @default(0)
  /// Existing rows changed by the import (assets)
  updated     Int        @default(0)
  skipped     Int        @default(0)
  failed      Int        @default(0)
  /// [{ row, value, reason }]
  issues      Json       @default("[]")
  createdById String?
  apiKeyId    String?
  createdAt   DateTime   @default(now())

  createdBy User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  apiKey    ApiKey?         @relation(fields: [apiKeyId], references: [id], onDelete: SetNull)
  records   ManHourRecord[]

  @@index([createdAt])
}

model ApiKey {
  id          String    @id @default(cuid())
  name        String
  prefix      String
  keyHash     String    @unique
  /// e.g. ["JOB_CARDS", "EMPLOYEES"]
  scopes      String[]  @default([])
  active      Boolean   @default(true)
  lastUsedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  createdBy     User?         @relation(fields: [createdById], references: [id], onDelete: SetNull)
  importBatches ImportBatch[]
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String   @default("")
  details   Json     @default("{}")
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entity, entityId])
  @@index([createdAt])
}
